# 生产环境变量模板 —— 由 deploy/bootstrap.sh 复制为仓库根 .env 并自动填充随机值。
# 请勿把填好真实值的 .env 提交到版本控制（.env 已被 .gitignore 忽略，权限 600）。
# 所有 CHANGE_ME 占位符会被一键脚本替换或清空；配置项里残留尖括号会被当成真实值。

# ---------- 对外访问 ----------
WEB_HOST=0.0.0.0
WEB_PORT=8080
# 挂反代 / HTTPS 时把 WEB_HOST 改成 127.0.0.1（或加 --local）

# ---------- 后端 ----------
NODE_ENV=production
PORT=3000
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRES_IN=7d
APP_MASTER_KEY=<CHANGE_ME>

# ---------- PostgreSQL ----------
POSTGRES_USER=dropshipping
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=dropshipping
DATABASE_URL=postgresql://dropshipping:<CHANGE_ME>@postgres:5432/dropshipping?schema=public

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- MinIO（面单 PDF / ZPL / 附件） ----------
MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>
# 与上面两项保持同值（一键脚本自动同步）；server 侧读取的就是这两个键
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=dropshipping

# ---------- 备份 ----------
BACKUP_ROOT=/opt/dropshipping-ops/backups
