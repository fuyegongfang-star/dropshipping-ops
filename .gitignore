# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 环境变量与密钥（切勿提交真实密钥，见方案 §17）
.env
.env.*
!.env.example
# 生产构建环境（review B3）：仅含 VITE_USE_MOCK=false，无密钥，必须随仓库发布，
# 否则 `npm run build` 在生产模式下无此文件会被 9.7 守卫拒绝（见 web/.env.production 注释）。
!.env.production

# 日志
logs/
*.log

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# Prisma 生成产物
server/node_modules/.prisma/

# 测试覆盖
coverage/

# 本地验收产物（截图 / 测试用图，非仓库内容；.dev/state.json 与 errors.log 仍纳入版本管理）
.dev/shots/
.dev/test-images/

# WorkBuddy 项目记忆（非仓库产物）
.workbuddy/
