// ============================================================================
// Prisma 数据模型 —— 一件代发货代运营系统
// 关联方案：dropshipping-fulfillment-architecture-plan.md（v1.5）
//
// 【核心约定】
// 1. 多租户：所有业务表均带 tenantId（行级隔离，见方案 §0 / §17）。
// 2. 金额单位：统一 Decimal(12,2)，币种单独字段；记账以基准币为准（§9/§10）。
// 3. 时间：统一 UTC（DateTime）；业务侧展示再按本地时区转换。
// 4. 关联：本初版以标量外键 + 索引表达关联（简洁、可演进）；
//    后续如需级联/导航属性，再补 @relation 字段。
//
// 本文件为 P0 数据模型定稿初版，字段随阶段细化可增补（如风控评分、审计字段）。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- 多租户 / 账号 / 权限（§0/§17/§22）--------------------------------------
model Tenant {
  id        String   @id @default(cuid())
  name      String // 商家客户名称
  code      String   @unique // 子域名/租户标识，网关据此解析租户
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  password  String // bcrypt 哈希；明文永不落库（§17）
  name      String? // 姓名/昵称
  status    String   @default("active") // active | disabled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // 角色名（admin | operator | finance ...）
  scope       String? // 精细化 RBAC 作用域（§22）：可限定到店铺/仓库/线路
  permissions Json? // 权限点列表（CASL 可推导）
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([tenantId])
}

// ---- 渠道店铺（§3）---------------------------------------------------------
model Shop {
  id         String   @id @default(cuid())
  tenantId   String
  platform   String // shopify | amazon | tiktok | taobao | douyin | independent
  name       String // 店铺展示名
  authConfig Json? // 平台授权信息（加密存储，§17）
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// ---- 商品与 SKU（平台↔内部↔供应商 映射，§1）---------------------------------
model Product {
  id        String   @id @default(cuid())
  tenantId  String
  title     String // 商品标题
  spu       String? // 标准产品单元编码
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Sku {
  id           String  @id @default(cuid())
  tenantId     String
  productId    String
  code         String // 内部 SKU 编码（唯一）
  platformSku  String? // 平台侧 SKU（各渠道）
  supplierSku  String? // 供应商侧 SKU
  barcode      String?
  weightG      Int // 实重（克）—— 计费重计算输入（§4）
  lengthCm     Int? // 长（厘米）
  widthCm      Int? // 宽（厘米）
  heightCm     Int? // 高（厘米）—— 体积重 = 长*宽*高 / 抛比系数
  createdAt    DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ---- 订单与状态机（§13）----------------------------------------------------
model Order {
  id              String   @id @default(cuid())
  tenantId        String
  shopId          String
  platformOrderNo String // 平台原始订单号
  status          String // 正向状态机（pending_review→approved→pushed→...→completed）
  subStatus       String? // 二维子状态
  raw             Json? // 平台原始订单字段（JSONB，保留溯源）
  recipient       Json? // 收件人信息（PII，存储需脱敏/加密，§17）
  selectedQuoteId String? // 试算→下单锁价引用（§4）
  totalAmount     Decimal? @db.Decimal(12, 2)
  currency        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, platformOrderNo])
  @@index([tenantId, status])
}

model OrderItem {
  id        String          @id @default(cuid())
  tenantId  String
  orderId   String
  skuId     String?
  quantity  Int
  price     Decimal?        @db.Decimal(12, 2)

  @@index([tenantId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  type      String // 状态转移事件类型
  from      String? // 源状态
  to        String? // 目标状态
  operator  String? // 操作人/系统
  createdAt DateTime @default(now()) // 事件时间（UTC）

  @@index([tenantId, orderId])
}

model OrderHold {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  reason    String // 挂起原因（风控/缺货/异常）
  releasedAt DateTime? // 释放时间；空表示仍挂起
  createdAt DateTime @default(now())

  @@index([tenantId, orderId])
}

model ReverseOrder {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  type      String // cancel（撤单）| intercept（拦截）| redirect（改址）| return（退货退款）
  status    String // pending | processing | done | failed
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ---- 物流 / 货代（§3/§4/§9/§14）-------------------------------------------
model Carrier {
  id        String   @id @default(cuid())
  code      String   @unique // yunexpress | dhl | 4px | yanwen
  name      String
  authType  String // oauth2 | hmac | md5（鉴权方式，§3 调研）
  createdAt DateTime @default(now())
}

model CarrierAccount {
  id          String   @id @default(cuid())
  tenantId    String
  carrierId   String
  credentials Json // 加密存储的账号密钥（§17）；绝不明文
  token       Json? // 缓存的 OAuth token，按 tenant+carrier 维度（§3）
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

// 物流产品：货代卖的是"产品"而非裸承运商（§4）
model LogisticsProduct {
  id               String  @id @default(cuid())
  tenantId         String
  carrierId        String?
  name             String // 例如「云途-标准专线」「DHL-Express」
  legType          String  @default("direct") // first（头程）| last（尾程）| direct（全程，§14）
  volumetricDivisor Int    @default(5000) // 抛比系数（§4）
  visible          Boolean @default(true) // 租户可见性
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

model SurchargeRule {
  id        String   @id @default(cuid())
  tenantId  String
  productId String?
  type      String // fuel（燃油）| remote（偏远）| oversize（超长超重）| duty_prepaid（关税预付）
  calc      Json // 计算规则：比例或固定（§4 附加费体系）
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// 试算报价（§4）：输入快照 + 当时费率/加价快照 + 有效期，下单引用锁价
model Quote {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  inputSnapshot   Json // 重量/体积/地址等试算输入
  rateSnapshot    Json // 当时费率 + 加价快照（保证试算价≈实收价）
  carrierCost     Decimal  @db.Decimal(12, 2) // 承运商成本
  sellPrice       Decimal  @db.Decimal(12, 2) // 商户可见售价（含平台加价，§9）
  margin          Decimal  @db.Decimal(12, 2) // 平台利润 = sellPrice - carrierCost
  currency        String
  expiresAt       DateTime // 报价有效期（锁价窗口）
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model RateQuote {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String?
  carrierCost     Decimal  @db.Decimal(12, 2)
  sellPrice       Decimal  @db.Decimal(12, 2)
  margin          Decimal  @db.Decimal(12, 2)
  currency        String
  fxRateSnapshot  Json? // 币种归一快照（§9/§10）
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Shipment {
  id               String   @id @default(cuid())
  tenantId         String
  orderId          String
  carrierId        String?
  productId        String?
  selectedQuoteId  String?
  trackingNo       String?
  status           String
  customs          Json? // 报关合规字段：HS/申报价值/币种/IOSS/EORI/VAT（§19）
  carrierCost      Decimal? @db.Decimal(12, 2) // 承运商成本
  sellPrice        Decimal? @db.Decimal(12, 2) // 商户售价（含加价）
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// 头程/尾程两段式物流（§14）
model ShipmentLeg {
  id          String   @id @default(cuid())
  tenantId    String
  shipmentId  String
  legType     String // first（头程）| last（尾程）
  carrierId   String?
  trackingNo  String?
  status      String
  createdAt   DateTime @default(now())

  @@index([tenantId, shipmentId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  tenantId    String
  shipmentId  String
  legType     String? // 轨迹所属段（头程/尾程）
  status      String
  location    String?
  occurredAt  DateTime // 事件发生时间（UTC）
  createdAt   DateTime @default(now())

  @@index([tenantId, shipmentId])
}

// ---- 加价 / 币种（§9/§10）--------------------------------------------------
model MarkupRule {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String // carrier | product | tenant（作用域，支持差异化定价）
  ruleType  String // percent（比例）| fixed（固定）| tiered（阶梯）| min_margin（最低毛利保护）
  params    Json // 规则参数
  currency  String
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model FxRate {
  id          String   @id @default(cuid())
  from        String // 源币种
  to          String // 目标币种（基准结算币）
  rate        Decimal  @db.Decimal(18, 8)
  source      String? // 汇率来源
  effectiveAt DateTime @default(now()) // 生效时间

  @@index([from, to])
}

// ---- 结算 / 账务（§9/§10/§16）---------------------------------------------
// 商户账单：基于 sellPrice（商户应付）
model Bill {
  id        String   @id @default(cuid())
  tenantId  String
  period    String? // 账期（如 2026-10）
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  status    String   @default("unpaid") // unpaid | paid | void
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// 承运商对账：基于 carrierCost（平台应付）
model Reconciliation {
  id        String   @id @default(cuid())
  tenantId  String
  carrierId String?
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  status    String   @default("open") // open | matched | settled
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// 商户钱包（预充值 / 信用账期，§16）
model Wallet {
  id        String   @id @default(cuid())
  tenantId  String
  balance   Decimal  @db.Decimal(12, 2) @default(0)
  currency  String
  createdAt DateTime @default(now())

  @@unique([tenantId, currency])
}

// 复式记账流水（§16）：amount 有正负，balanceAfter 为变动后余额
model LedgerEntry {
  id           String   @id @default(cuid())
  tenantId     String
  walletId     String
  type         String // charge（扣费）| refund（退款）| payout（提现）| adjust（调整）
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  refType      String? // order | bill | refund（关联业务类型）
  refId        String? // 关联业务 ID
  createdAt    DateTime @default(now())

  @@index([tenantId, walletId])
}

// ---- 仓储 / 海外仓（§15）---------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String   @default("overseas") // domestic（国内仓）| overseas（海外仓）
  region    String? // 区域/国家
  createdAt DateTime @default(now())
}

model Bin {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  code        String // 库位编码
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model Asn {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  status      String // 收货单状态：pending | received | closed
  createdAt   DateTime @default(now())
}

model Inventory {
  id        String   @id @default(cuid())
  tenantId  String
  warehouseId String
  skuId     String
  binId     String?
  qty       Int      @default(0) // 在库数量
  lockedQty Int      @default(0) // 已锁定数量（出库/拣货占用，§15）
  createdAt DateTime @default(now())

  @@unique([tenantId, warehouseId, skuId, binId])
  @@index([tenantId])
}

model PickTask {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  orderId     String?
  status      String // pending | picking | done
  createdAt   DateTime @default(now())
}

model CycleCount {
  id          String   @id @default(cuid())
  tenantId    String
  warehouseId String
  status      String // pending | counting | done
  createdAt   DateTime @default(now())
}

// ---- 供应商代发（§21）------------------------------------------------------
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
}

model SupplierSku {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  skuId       String
  supplierSku String // 供应商侧 SKU 编码
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model SupplierOrder {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  orderId     String?
  status      String // pushed | accepted | shipped | done
  createdAt   DateTime @default(now())
}

model SupplierSettlement {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  status      String // open | settled
  createdAt   DateTime @default(now())
}

// ---- 合规 / 地址 / 理赔（§18/§19/§20）-------------------------------------
model ZoneMap {
  id          String   @id @default(cuid())
  tenantId    String
  country     String // 国家/地区代码
  zipPattern  String // 邮编正则/区间
  zone        String // 分区（用于运费分区，§18）
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model ComplianceRule {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // hs_code | ioss | eori | vat | section321（§19）
  rule      Json // 合规规则配置
  createdAt DateTime @default(now())
}

model Claim {
  id          String   @id @default(cuid())
  tenantId    String
  shipmentId  String
  type        String // lost | damage | delay（§20）
  status      String // open | processing | closed
  amount      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

// ---- 运维 / 集成（§3/§24）--------------------------------------------------
// 入站 Webhook 事件（承运商轨迹推送等，需验签，§3/§17）
model WebhookEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  source    String // 来源（yunexpress | dhl ...）
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}
