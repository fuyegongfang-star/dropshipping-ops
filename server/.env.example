# 服务端口
PORT=3000

# PostgreSQL（多租户主库）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dropshipping?schema=public"

# Redis（缓存 + BullMQ 队列）
REDIS_URL="redis://localhost:6379"

# JWT（鉴权，见方案 §0/§22）
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="7d"

# MinIO（对象存储：面单 PDF / 附件，见方案 §11）
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="dropshipping"
