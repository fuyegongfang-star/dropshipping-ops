# 全仓统一 LF：Windows CRLF 会让 Linux 容器里的 .sh 报 bad interpreter: /bin/sh^M
* text=auto eol=lf

*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env*      text eol=lf
*.md        text eol=lf
*.svg       text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.prisma    text eol=lf

# 二进制资源不做换行转换
*.png       binary
*.jpg       binary
*.ico       binary
*.zip       binary
